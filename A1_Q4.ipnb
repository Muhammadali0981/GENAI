   "source": [
    "input_layer = layers.Input(shape=(64,64,1))\n",
    "\n",
    "input_layer = layers.Input(shape=(32, 32, 3))\n",
    "\n",
    "conv_layer_1 = layers.Conv2D(\n",
    "    filters=10,\n",
    "    kernel_size=(4, 4),\n",
    "    strides=2,\n",
    "    padding=\"same\",\n",
    "    activation=\"relu\"\n",
    ")(input_layer)\n",
    "\n",
    "conv_layer_2 = layers.Conv2D(\n",
    "    filters=20,\n",
    "    kernel_size=(3, 3),\n",
    "    strides=2,\n",
    "    padding=\"same\",\n",
    "    activation=\"relu\"\n",
    ")(conv_layer_1)\n",
    "\n",
    "flatten_layer = layers.Flatten()(conv_layer_2)\n",
    "\n",
    "output_layer = layers.Dense(\n",
    "    units=10,\n",
    "    activation=\"softmax\"\n",
    ")(flatten_layer)\n",
    "\n",
    "cnn_model = models.Model(\n",
    "    input_layer,\n",
    "    output_layer\n",
    ")\n",
    "\n",
    "cnn_model.summary()\n"
   ]
  },
