    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "CLASSES = np.array([\n",
    "    \"airplane\",\n",
    "    \"automobile\",\n",
    "    \"bird\",\n",
    "    \"cat\",\n",
    "    \"deer\",\n",
    "    \"dog\",\n",
